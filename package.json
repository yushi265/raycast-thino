{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "raycast-thino",
  "title": "Thino Memo",
  "description": "Obsidian デイリーノートに Thino 互換のタイムスタンプ付きメモを素早く追加する",
  "icon": "extension-icon.png",
  "author": "shiina",
  "categories": ["Productivity"],
  "license": "MIT",
  "commands": [
    {
      "name": "add-memo",
      "title": "Add Thino Memo",
      "description": "タイムスタンプ付きメモを Obsidian デイリーノートの末尾に追記する",
      "mode": "view"
    }
  ],
  "preferences": [
    {
      "name": "vaultPath",
      "title": "Vault Path",
      "description": "Obsidian vault のフルパス",
      "type": "directory",
      "required": true,
      "default": ""
    },
    {
      "name": "dailyNoteFolder",
      "title": "Daily Note Folder",
      "description": "vault 内のデイリーノートフォルダの相対パス",
      "type": "textfield",
      "required": false,
      "default": "00_Journals/01_Daily"
    },
    {
      "name": "templatePath",
      "title": "Daily Note Template Path",
      "description": "vault 内のデイリーノートテンプレートの相対パス（拡張子なし）",
      "type": "textfield",
      "required": false,
      "default": "99_Templates/01_DailyNote"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.93.1"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^1.0.11",
    "@types/node": "22.13.10",
    "@types/react": "19.0.10",
    "eslint": "^8.57.0",
    "typescript": "^5.4.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish"
  }
}
